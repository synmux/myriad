---
config:
  theme: redux-dark-color
  themeVariables:
    background: "#fafafa"
    primaryColor: "#dae8fc"
    primaryTextColor: "#1a1a1a"
    primaryBorderColor: "#6c8ebf"
    lineColor: "#666666"
    secondaryColor: "#fff2cc"
    tertiaryColor: "#d5e8d4"
  flowchart:
    curve: cardinal
---
flowchart TD
    A(["Start"]) --> B["Parse --discarded, --no-summary, and --delete"]
    B --> C{"Firebase ID token available?"}
    C -->|No| D["Exit with token setup error"]
    C -->|Yes| E["Set scan time; initialize matches and scanned count"]
    E --> F["Iterate listable statuses"]
    F --> G["Fetch conversation page from app API"]
    G --> H{"HTTP 401?"}
    H -->|Yes| I["Exit with expired-token error"]
    H -->|No| J["Validate pagination; deduplicate rows"]
    J --> K["Evaluate each conversation"]
    K --> L{"Older than 24 hours?"}
    L -->|No| O{"More pages?"}
    L -->|Yes| M{"Unfinished status or completed but still processing?"}
    M -->|Yes| N["Record match and reason"]
    M -->|No| P{"Discarded and --discarded enabled?"}
    P -->|Yes| N
    P -->|No| Q{"--no-summary enabled and overview empty?"}
    Q -->|Yes| N
    Q -->|No| O
    N --> O
    O -->|Yes| G
    O -->|No| R{"More statuses?"}
    R -->|Yes| F
    R -->|No| S["Print scan summary"]
    S --> T{"--delete enabled?"}
    T -->|No| U(["Return success"])
    T -->|Yes| V["Delete each matched conversation"]
    V --> W{"Any deletion failed?"}
    W -->|Yes| X(["Return failure"])
    W -->|No| Y(["Return success"])

    classDef default fill:#f5f5f5,stroke:#999999,stroke-width:1px,color:#333333
    classDef terminal fill:#d5e8d4,stroke:#82b366,stroke-width:3px,color:#333333
    classDef setup fill:#e8d5f5,stroke:#7b4fa6,stroke-width:2px,color:#333333
    classDef fetch fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px,color:#333333
    classDef evaluate fill:#d5f0ee,stroke:#4a9a94,stroke-width:2px,color:#333333
    classDef decision fill:#fff2cc,stroke:#d6b656,stroke-width:2px,color:#333333
    classDef match fill:#ffe6cc,stroke:#d79b00,stroke-width:2px,color:#333333
    classDef report fill:#eeeeee,stroke:#666666,stroke-width:2px,color:#333333
    classDef danger fill:#f9dfc7,stroke:#c0504d,stroke-width:2px,color:#333333
    classDef error fill:#f8cecc,stroke:#b85450,stroke-width:2px,color:#333333

    class A,U,Y terminal
    class B,E setup
    class F,G,J fetch
    class K evaluate
    class C,H,L,M,O,P,Q,R,T,W decision
    class N match
    class S report
    class V danger
    class D,I,X error

    linkStyle default stroke:#999999,stroke-width:1px
    linkStyle 2,7,28 stroke:#b85450,stroke-width:2px
    linkStyle 13,15,17,19 stroke:#d79b00,stroke-width:2px
    linkStyle 25,29 stroke:#82b366,stroke-width:2px
